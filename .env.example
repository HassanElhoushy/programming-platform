# =============================================================================
# متغيرات البيئة — منصة البرمجة
# هذا الملف محلي فقط ولا يُرفع على GitHub (مستثنى في .gitignore).
# نفس المتغيرات لازم تتحط في Vercel: Settings -> Environment Variables.
# =============================================================================

# مشروع Supabase (عام — يظهر في المتصفح بطبيعته، والحماية في RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# المفتاح السرّي (sb_secret_...) — سيرفر فقط. لا تضعه أبداً في متغير NEXT_PUBLIC_
# Supabase Dashboard -> Project Settings -> API Keys -> Secret keys
SUPABASE_SECRET_KEY=sb_secret_...
